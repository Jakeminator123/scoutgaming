   "text": "Bets are closed. Good luck, everyone.",
   "handelse": "insatserna stängs",
   "dur": 3.38
  },
  {
   "id": "goodluck_3",
   "event": "goodluck",
   "url": "/media_omkodad_crf20_2026-09-25/repliker/goodluck_3.mp4",
