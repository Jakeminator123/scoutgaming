# Kopiera till .env och fyll i. .env är gitignorerad — checka aldrig in den.

# Svarstexten — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Rösten — https://play.cartesia.ai → API Keys
CARTESIA_API_KEY=

# Läppsynken — RunPod-kontot där endpointen ligger (Settings → API Keys)
RUNPOD_API_KEY=
# Spelbildens endpoint (astrid-gpu-worker, avatar astrid_spel2x)
RUNPOD_ENDPOINT_ID=tdkbn6qxcyh4so

# --- valfritt -----------------------------------------------------------
# PORT=8600
# CARTESIA_VOICE=bcdcad6d-4eb6-4a71-89fd-1ae2ce9f95d8     # Freja – Informative Host (standard); Victoria: dc30854e-e398-4579-9dc8-16f6cb2c19b9
# GEMINI_MODEL=gemini-3.5-flash-lite
# Satt → POST /api/* kräver "Authorization: Bearer <token>" (sätt när servern ligger publikt)
# API_TOKEN=
# Egen fast publik adress (annars skriver `npm run share` sin trycloudflare-adress till public-url.txt)
# SESSION_URL=wss://astrid.exempel.se

# OpenClaw: select reviewed replies through the separate product-speech role.
# No Gateway/model key is needed in this application.
# DEALER_LLM_PROVIDER=openclaw
# OPENCLAW_PRODUCT_SPEECH_URL=https://your-director.example
# OPENCLAW_PRODUCT_SPEECH_TOKEN=
# Read-only MCP live trace (optional; MCP inherits these environment variables).
# CROUPIER_GAME_URL=http://127.0.0.1:8600
# GAME_AUDIT_TOKEN=
