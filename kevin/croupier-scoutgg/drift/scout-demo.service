[Unit]
Description=Scout Astrid playable demo (croupier.scoutgg.dev)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=astrid-scout
Group=astrid-scout
WorkingDirectory=/opt/astrid-scout-demo/current
EnvironmentFile=/etc/astrid-scout-demo.env
ExecStart=/usr/bin/node server/server.mjs
Restart=always
RestartSec=3
StateDirectory=astrid-scout-demo
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/astrid-scout-demo

[Install]
WantedBy=multi-user.target
