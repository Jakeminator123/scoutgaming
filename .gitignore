# The only .gitignore in the repository. Patterns for a subfolder are written
# rooted here (/apps/web/...). Docker build contexts keep their own .dockerignore.

# Local secrets, agent state and private files.
.env*
!.env.example
.vercel
.claude/
.croupier-inbox/
inbox-token.txt
.DS_Store
# Personal historical reports are kept outside the active checkout.
/random-stuff-jakob/jakob-docs/arkiv/
/random-stuff-jakob/jakob-docs/KEVIN-ATKOMST-PRIVAT.txt
# Canonical local recovery archive (AGENTS.md); nothing in it is versioned.
/arkiv/
# Per-checkout inbox identity; account email and local paths stay off GitHub.
/inbox/local-device.json
/inbox/local-device.json.*.tmp

# Generated dependencies, build caches and local verification output.
node_modules/
.next/
.next-probe/
.cache/
.turbo/
coverage/
playwright-report/
test-results/
__pycache__/
*.py[cod]
.venv/
*.tsbuildinfo
*.log
*-debug.log*
yarn-error.log*
vendor/
# Reviewed third-party code that is part of a service, not a cache.
!/services/game/public/vendor/
!/services/moving-gpu-worker/vendor/
/services/moving-gpu-worker/vendor/*
!/services/moving-gpu-worker/vendor/motor.py
!/services/moving-gpu-worker/vendor/rorlig.py
/services/moving-gpu-worker/.build/
/services/astrid-gpu-worker/gateway/.npm-cache/

# Media migration ledger.
/media/.migration/

# Studio build output; never source.
/apps/studio/preview-build/
/apps/studio/design-preview-build/
/apps/studio/public/public-assistant.js
/apps/studio/public/did-chunks/

# Web build output and copies generated by prepare-platform-ui.
/apps/web/out/
/apps/web/build
/apps/web/next-env.d.ts
/apps/web/**/runtime-ui/
/apps/web/public/*.mjs
/apps/web/public/*.js
/apps/web/public/*.css
/apps/web/public/speech-media.json
/apps/web/public/dealer-voice-catalog.json
/apps/web/public/presentation-runtime/
/apps/web/public/lab/
/apps/web/public/bo/
/apps/web/public/card-presentation/
/apps/web/public/composition-runtime/
/apps/web/public/packages/
/apps/web/public/web/

# Local export output written by tools/export-media-blob.mjs; never source.
/apps/studio/**/data/

# Director/Gateway local state: the Director adapter defaults to the relative
# open-claw/lab root when LAB_DATA_DIR is unset (Render sets it).
/open-claw/lab/data/
/open-claw/lab/runtime/
/open-claw/lab/media/*
/services/openclaw/lab/**/data/
/services/openclaw/lab/media/*
!/services/openclaw/lab/media/README.md
