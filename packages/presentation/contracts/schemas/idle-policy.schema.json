{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://croupier.local/schemas/idle-policy.schema.json",
  "title": "Croupier lab idle policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "familyId", "base", "variants"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "familyId": { "type": "string", "pattern": "^[a-z][a-z0-9-]*/idle\\.ready/ready$" },
    "base": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": { "$ref": "#/$defs/base" }
    },
    "rotation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clips"],
      "properties": {
        "clips": { "type": "array", "minItems": 1, "maxItems": 31, "items": { "$ref": "#/$defs/rotationClip" } }
      }
    },
    "variants": {
      "type": "array",
      "maxItems": 30,
      "items": { "$ref": "#/$defs/variant" }
    }
  },
  "$defs": {
    "rotationClip": {
      "type": "object",
      "additionalProperties": false,
      "required": ["videoId", "phase", "from", "to", "weight", "head", "calm"],
      "properties": {
        "videoId": { "$ref": "#/$defs/videoId" },
        "phase": { "enum": ["any", "bets", "decide"] },
        "from": { "enum": ["rest", "clasped"] },
        "to": { "enum": ["rest", "clasped"] },
        "weight": { "type": "number", "exclusiveMinimum": 0, "maximum": 100 },
        "head": { "type": "boolean" },
        "calm": { "type": "boolean" }
      }
    },
    "videoId": {
      "type": "string",
      "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
    },
    "duration": {
      "type": "integer",
      "minimum": 200,
      "maximum": 60000
    },
    "base": {
      "type": "object",
      "additionalProperties": false,
      "required": ["videoId", "weight", "durationMs"],
      "properties": {
        "videoId": { "$ref": "#/$defs/videoId" },
        "weight": { "type": "integer", "minimum": 1, "maximum": 100 },
        "durationMs": { "$ref": "#/$defs/duration" }
      }
    },
    "automatic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["averageEveryMs", "jitterMs", "cooldownMs", "maxPerMinute"],
      "properties": {
        "averageEveryMs": { "type": "integer", "minimum": 5000, "maximum": 300000 },
        "jitterMs": { "type": "integer", "minimum": 0, "maximum": 60000 },
        "cooldownMs": { "type": "integer", "minimum": 0, "maximum": 300000 },
        "maxPerMinute": { "type": "integer", "minimum": 1, "maximum": 12 }
      }
    },
    "variant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["videoId", "durationMs", "use", "automatic"],
      "properties": {
        "description": { "type": "string", "maxLength": 80, "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]*$" },
        "videoId": { "$ref": "#/$defs/videoId" },
        "durationMs": { "$ref": "#/$defs/duration" },
        "use": { "enum": ["manual", "automatic", "rules", "openclaw", "rotation"] },
        "automatic": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/automatic" }
          ]
        }
      }
    }
  }
}
