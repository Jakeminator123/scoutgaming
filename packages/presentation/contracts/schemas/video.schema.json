{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://croupier.local/schemas/video.schema.json",
  "title": "Kategorisering av en labbvideo",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "label",
    "dealerId",
    "eventId",
    "kind",
    "role",
    "situation",
    "notes"
  ],
  "$defs": {
    "recordedSpeechIdentity": {
      "type": "object",
      "required": [
        "dealerId",
        "lineId",
        "takeId",
        "language",
        "exactText",
        "videoSha256",
        "audioSha256",
        "indexSha256",
        "fps",
        "frameCount",
        "audioDelayMs",
        "entryPose",
        "exitPose",
        "calibrationRevision"
      ],
      "properties": {
        "dealerId": {
          "type": "string",
          "maxLength": 40,
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
        },
        "lineId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,99}$"
        },
        "takeId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,99}$"
        },
        "language": {
          "type": "string",
          "pattern": "^[a-z]{2,3}(?:-[A-Z]{2})?$"
        },
        "exactText": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "videoSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "audioSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "indexSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "fps": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 240
        },
        "frameCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 28800
        },
        "audioDelayMs": {
          "type": "integer",
          "minimum": -5000,
          "maximum": 5000
        },
        "entryPose": {
          "enum": [
            "VILA",
            "REDO"
          ]
        },
        "exitPose": {
          "enum": [
            "VILA",
            "REDO"
          ]
        },
        "calibrationRevision": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,99}$"
        }
      }
    },
    "recordedSpeechPending": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "const": "pending"
        }
      }
    },
    "recordedSpeechBoundProof": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "by",
        "at",
        "identity"
      ],
      "properties": {
        "status": {
          "enum": [
            "verified-recording",
            "approved",
            "rejected"
          ]
        },
        "by": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "identity": {
          "allOf": [
            {
              "$ref": "#/$defs/recordedSpeechIdentity"
            }
          ],
          "unevaluatedProperties": false
        }
      }
    }
  },
  "properties": {
    "recordedSpeech": {
      "type": "object",
      "description": "Optional exact recording tuple. Runtime validation also binds both proofs to this identity, the dealer, line and media bytes; verification never implies audiovisual approval.",
      "allOf": [
        {
          "$ref": "#/$defs/recordedSpeechIdentity"
        }
      ],
      "unevaluatedProperties": false,
      "required": [
        "schemaVersion",
        "recording",
        "review"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "recording": {
          "oneOf": [
            {
              "$ref": "#/$defs/recordedSpeechPending"
            },
            {
              "allOf": [
                {
                  "$ref": "#/$defs/recordedSpeechBoundProof"
                },
                {
                  "properties": {
                    "status": {
                      "enum": [
                        "verified-recording"
                      ]
                    }
                  }
                }
              ]
            }
          ]
        },
        "review": {
          "oneOf": [
            {
              "$ref": "#/$defs/recordedSpeechPending"
            },
            {
              "allOf": [
                {
                  "$ref": "#/$defs/recordedSpeechBoundProof"
                },
                {
                  "properties": {
                    "status": {
                      "enum": [
                        "approved",
                        "rejected"
                      ]
                    }
                  }
                }
              ]
            }
          ]
        }
      }
    },
    "familyId": {
      "type": "string",
      "pattern": "^astrid/[a-z.]+/[a-z0-9_-]+$",
      "description": "Optional explicit shared-family intake; only alternative uploads may use this field."
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "dealerId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "eventId": {
      "enum": [
        "speak.goodluck",
        "speak.insurance",
        "speak.double",
        "speak.other",
        "deal.player.left",
        "deal.player.centre",
        "deal.player.right",
        "deal.dealer",
        "reveal.dealer",
        "turn.player",
        "settle.blackjack",
        "settle.dealerBust",
        "settle.win",
        "settle.push",
        "settle.other",
        "idle.ready",
        "transition.shoe",
        "roulette.reference",
        "roulette.idle",
        "roulette.wheel-start"
      ]
    },
    "kind": {
      "enum": [
        "idle",
        "action",
        "speech",
        "reaction"
      ]
    },
    "role": {
      "enum": [
        "standard",
        "alternative"
      ]
    },
    "situation": {
      "type": "string",
      "maxLength": 80
    },
    "notes": {
      "type": "string",
      "maxLength": 1500
    },
    "playback": {
      "enum": [
        "once"
      ],
      "default": "once"
    },
    "compositing": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode"
          ],
          "properties": {
            "mode": {
              "const": "opaque"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "threshold",
            "softness",
            "despill"
          ],
          "properties": {
            "mode": {
              "const": "green-screen"
            },
            "threshold": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "softness": {
              "type": "number",
              "minimum": 0.001,
              "maximum": 1
            },
            "despill": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode"
          ],
          "properties": {
            "mode": {
              "const": "alpha"
            }
          }
        }
      ]
    },
    "archived": {
      "type": "boolean"
    },
    "mediaType": {
      "enum": [
        "audio",
        "image"
      ]
    },
    "framing": {
      "type": "object",
      "required": [
        "scale",
        "x",
        "y"
      ],
      "properties": {
        "x": {
          "type": "number",
          "minimum": -2,
          "maximum": 2
        },
        "y": {
          "type": "number",
          "minimum": -2,
          "maximum": 2
        },
        "scale": {
          "type": "number",
          "minimum": 0.25,
          "maximum": 6
        }
      },
      "additionalProperties": false
    },
    "game": {
      "const": "roulette"
    },
    "action": {
      "enum": [
        "reference",
        "breathing",
        "glasses-clean",
        "wheel-start"
      ]
    },
    "startPose": {
      "description": "Roulette: VILA/WHEEL/unverified. Blackjack action clips: declared hand pose VILA or REDO at the first frame; advisory until a filmed profile verifies it.",
      "enum": [
        "VILA",
        "REDO",
        "WHEEL",
        "unverified"
      ]
    },
    "endPose": {
      "enum": [
        "VILA",
        "REDO",
        "WHEEL",
        "unverified"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "eventId": {
            "const": "speak.goodluck"
          }
        }
      },
      "then": {
        "properties": {
          "kind": {
            "const": "speech"
          },
          "situation": {
            "enum": [
              "goodluck"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "eventId": {
            "const": "speak.insurance"
          }
        }
      },
      "then": {
        "properties": {
          "kind": {
            "const": "speech"
          },
          "situation": {
            "enum": [
              "insurance"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "eventId": {
            "const": "speak.double"
          }
        }
      },
      "then": {
        "properties": {
          "kind": {
            "const": "speech"
          },
          "situation": {
            "enum": [
              "double"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "eventId": {
            "const": "speak.other"
          }
        }
      },
      "then": {
        "properties": {
          "kind": {
            "const": "speech"
          },
          "situation": {
            "enum": [
              "placebets",
              "dealerblackjack",
              "blackjack",
              "dealerbust",
              "win",
              "push",
              "lose",
              "greeting",
              "peek",
              "bust",
              "sidebet",
              "chatter1",
              "chatter2",
              "farewell"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "eventId": {
            "const": "deal.player.left"
          }
        }
      },
      "then": {
        "properties": {
          "kind": {
            "const": "action"
          },
          "situation": {
            "enum": [
              "box0",
              "box1"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "eventId": {
            "const": "deal.player.centre"
          }
        }
      },
      "then": {
        "properties": {
          "kind": {
            "const": "action"
          },
          "situation": {
            "enum": [
              "box2",
              "box3",
              "box4"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "eventId": {
            "const": "deal.player.right"
          }
        }
      },
      "then": {
        "properties": {
          "kind": {
            "const": "action"
          },
          "situation": {
            "enum": [
              "box5",
              "box6"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "eventId": {
            "const": "deal.dealer"
          }
        }
      },
      "then": {
        "properties": {
          "kind": {
            "const": "action"
          },
          "situation": {
            "enum": [
              "dealer-up",
              "dealer-hole"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "eventId": {
            "const": "reveal.dealer"
          }
        }
      },
      "then": {
        "properties": {
          "kind": {
            "const": "action"
          },
          "situation": {
            "enum": [
              "dealer-hole"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "eventId": {
            "const": "turn.player"
          }
        }
      },
      "then": {
        "properties": {
          "kind": {
            "const": "reaction"
          },
          "situation": {
            "enum": [
              ""
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "eventId": {
            "const": "settle.blackjack"
          }
        }
      },
      "then": {
        "properties": {
          "kind": {
            "const": "reaction"
          },
          "situation": {
            "enum": [
              ""
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "eventId": {
            "const": "settle.dealerBust"
          }
        }
      },
      "then": {
        "properties": {
          "kind": {
            "const": "reaction"
          },
          "situation": {
            "enum": [
              ""
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "eventId": {
            "const": "settle.win"
          }
        }
      },
      "then": {
        "properties": {
          "kind": {
            "const": "reaction"
          },
          "situation": {
            "enum": [
              ""
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "eventId": {
            "const": "settle.push"
          }
        }
      },
      "then": {
        "properties": {
          "kind": {
            "const": "reaction"
          },
          "situation": {
            "enum": [
              ""
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "eventId": {
            "const": "settle.other"
          }
        }
      },
      "then": {
        "properties": {
          "kind": {
            "const": "reaction"
          },
          "situation": {
            "enum": [
              ""
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "eventId": {
            "const": "idle.ready"
          }
        }
      },
      "then": {
        "properties": {
          "kind": {
            "const": "idle"
          },
          "situation": {
            "enum": [
              ""
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "eventId": {
            "const": "transition.shoe"
          }
        }
      },
      "then": {
        "properties": {
          "kind": {
            "const": "action"
          },
          "situation": {
            "enum": [
              "to-shoe",
              "from-shoe"
            ]
          }
        }
      }
    }
  ]
}
