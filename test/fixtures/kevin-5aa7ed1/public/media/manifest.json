 "repliker_sprak": {
  "es": [
   {
    "id": "greeting_1",
    "event": "greeting",
    "url": "/media/repliker-es/greeting_1_es.mp4",
    "text": "Buenas noches y bienvenido a la mesa. Soy Astrid, siéntese donde prefiera.",
    "dur": 6.42
   },
   {
    "id": "greeting_2",
    "event": "greeting",
    "url": "/media/repliker-es/greeting_2_es.mp4",
    "text": "Adelante, bienvenido. Tome asiento: las cartas están recién barajadas y la mesa es toda suya.",
    "dur": 9.21
   },
   {
    "id": "greeting_3",
    "event": "greeting",
    "url": "/media/repliker-es/greeting_3_es.mp4",
    "text": "Una cara nueva en la mesa. Bienvenido, soy Astrid y esta noche seré su crupier.",
    "dur": 7.04
   },
   {
    "id": "placebets_1",
    "event": "placebets",
    "url": "/media/repliker-es/placebets_1_es.mp4",
    "text": "Se abren las apuestas. Coloquen sus fichas cuando quieran.",
    "dur": 5.21
   },
   {
    "id": "placebets_2",
    "event": "placebets",
    "url": "/media/repliker-es/placebets_2_es.mp4",
    "text": "Nueva ronda, cartas nuevas. La casilla de apuestas es toda suya.",
    "dur": 7.46
   },
   {
    "id": "placebets_3",
    "event": "placebets",
    "url": "/media/repliker-es/placebets_3_es.mp4",
    "text": "La mesa está abierta. Tómense su tiempo y hagan sus apuestas.",
    "dur": 6.25
