 "repliker": [
  {
   "id": "greeting_1",
   "event": "greeting",
   "url": "/media/repliker/greeting_1.mp4",
   "text": "Good evening, and welcome to the table. I'm Astrid, take any seat you like.",
   "handelse": "spelaren kommer in",
   "dur": 5.21
  },
  {
   "id": "greeting_2",
   "event": "greeting",
   "url": "/media/repliker/greeting_2.mp4",
   "text": "Welcome in. Pull up a chair, the cards are fresh and the table is yours.",
   "handelse": "spelaren kommer in",
   "dur": 5.54
  },
  {
   "id": "greeting_3",
   "event": "greeting",
   "url": "/media/repliker/greeting_3.mp4",
   "text": "A new face at the table. Welcome, I'm Astrid, and I'll be dealing for you tonight.",
   "handelse": "spelaren kommer in",
   "dur": 5.29
  },
  {
   "id": "placebets_1",
   "event": "placebets",
   "url": "/media/repliker/placebets_1.mp4",
   "text": "Bets are open. Place your chips whenever you're ready.",
   "handelse": "ny runda, insatser öppna",
   "dur": 3.71
  },
  {
   "id": "placebets_2",
   "event": "placebets",
   "url": "/media/repliker/placebets_2.mp4",
   "text": "New round, fresh cards. The betting circle is all yours.",
   "handelse": "ny runda, insatser öppna",
   "dur": 4.75
  },
  {
   "id": "placebets_3",
   "event": "placebets",
   "url": "/media/repliker/placebets_3.mp4",
   "text": "The table is open. Take your time, and place your bets.",
   "handelse": "ny runda, insatser öppna",
   "dur": 4.58
  },
  {
   "id": "goodluck_1",
   "event": "goodluck",
   "url": "/media/repliker/goodluck_1.mp4",
   "text": "No more bets. Here come the cards.",
   "handelse": "insatserna stängs",
   "dur": 3.38
  },
  {
   "id": "goodluck_2",
   "event": "goodluck",
   "url": "/media/repliker/goodluck_2.mp4",
   "text": "Bets are closed. Good luck, everyone.",
   "handelse": "insatserna stängs",
   "dur": 3.38
  },
  {
   "id": "goodluck_3",
   "event": "goodluck",
   "url": "/media/repliker/goodluck_3.mp4",
   "text": "That's all the bets. Let's see what the shoe has for us.",
   "handelse": "insatserna stängs",
   "dur": 3.75
  },
  {
   "id": "sidebet_1",
   "event": "sidebet",
   "url": "/media/repliker/sidebet_1.mp4",
   "text": "Your side bet comes in. That one pays straight away.",
   "handelse": "en sidobet vinner",
   "dur": 4.0
  },
  {
   "id": "sidebet_2",
   "event": "sidebet",
   "url": "/media/repliker/sidebet_2.mp4",
   "text": "Side bet's a winner. Nice way to start the hand.",
   "handelse": "en sidobet vinner",
   "dur": 3.75
  },
  {
   "id": "sidebet_3",
   "event": "sidebet",
   "url": "/media/repliker/sidebet_3.mp4",
   "text": "And the side bet lands. Paid before we've even begun.",
   "handelse": "en sidobet vinner",
   "dur": 4.08
  },
  {
   "id": "insurance_1",
   "event": "insurance",
   "url": "/media/repliker/insurance_1.mp4",
   "text": "Ace showing. Would anyone like insurance?",
   "handelse": "försäkring erbjuds",
   "dur": 3.21
  },
  {
   "id": "insurance_2",
   "event": "insurance",
   "url": "/media/repliker/insurance_2.mp4",
   "text": "I have an ace. Insurance is open, and it pays two to one.",
   "handelse": "försäkring erbjuds",
   "dur": 4.58
  },
  {
   "id": "insurance_3",
   "event": "insurance",
   "url": "/media/repliker/insurance_3.mp4",
   "text": "Ace up, so insurance is on offer. Entirely your call.",
   "handelse": "försäkring erbjuds",
   "dur": 4.67
  },
  {
   "id": "double_1",
   "event": "double",
   "url": "/media/repliker/double_1.mp4",
   "text": "Doubling down. One card, and one card only.",
   "handelse": "spelaren dubblar",
   "dur": 4.17
  },
  {
   "id": "double_2",
   "event": "double",
   "url": "/media/repliker/double_2.mp4",
   "text": "Double it is. Here's your one card.",
   "handelse": "spelaren dubblar",
   "dur": 2.88
  },
  {
   "id": "double_3",
   "event": "double",
   "url": "/media/repliker/double_3.mp4",
   "text": "Doubled. One card to settle it.",
   "handelse": "spelaren dubblar",
   "dur": 3.29
  },
  {
   "id": "bust_1",
   "event": "bust",
   "url": "/media/repliker/bust_1.mp4",
   "text": "Over twenty-one, I'm afraid. That hand is done.",
   "handelse": "spelarens hand över 21",
   "dur": 4.25
  },
  {
   "id": "bust_2",
   "event": "bust",
   "url": "/media/repliker/bust_2.mp4",
   "text": "That's a bust. Unlucky card.",
   "handelse": "spelarens hand över 21",
   "dur": 3.29
  },
  {
   "id": "bust_3",
   "event": "bust",
   "url": "/media/repliker/bust_3.mp4",
   "text": "Too many, I'm sorry. That one goes to the house.",
   "handelse": "spelarens hand över 21",
   "dur": 3.46
  },
  {
   "id": "blackjack_1",
   "event": "blackjack",
   "url": "/media/repliker/blackjack_1.mp4",
   "text": "Blackjack! Beautifully done. That pays three to two.",
   "handelse": "spelaren får blackjack och vinner",
   "dur": 4.5
  },
  {
   "id": "blackjack_2",
   "event": "blackjack",
   "url": "/media/repliker/blackjack_2.mp4",
   "text": "Blackjack, straight off the deal. Paid three to two.",
   "handelse": "spelaren får blackjack och vinner",
   "dur": 4.0
  },
  {
   "id": "blackjack_3",
   "event": "blackjack",
   "url": "/media/repliker/blackjack_3.mp4",
   "text": "Now that's how you open a hand. Blackjack, three to two.",
   "handelse": "spelaren får blackjack och vinner",
   "dur": 4.42
  },
  {
   "id": "dealerblackjack_1",
   "event": "dealerblackjack",
   "url": "/media/repliker/dealerblackjack_1.mp4",
   "text": "Dealer has blackjack. I'm sorry, everyone.",
   "handelse": "dealern har blackjack",
   "dur": 3.75
  },
  {
   "id": "dealerblackjack_2",
   "event": "dealerblackjack",
   "url": "/media/repliker/dealerblackjack_2.mp4",
   "text": "Blackjack for the house this time. It happens to the best of us.",
   "handelse": "dealern har blackjack",
   "dur": 4.5
  },
  {
   "id": "dealerblackjack_3",
   "event": "dealerblackjack",
   "url": "/media/repliker/dealerblackjack_3.mp4",
   "text": "I'm afraid it's blackjack for me. That round goes to the house.",
   "handelse": "dealern har blackjack",
   "dur": 4.5
  },
  {
   "id": "dealerbust_1",
   "event": "dealerbust",
   "url": "/media/repliker/dealerbust_1.mp4",
   "text": "Dealer busts! Everyone still in the hand gets paid.",
   "handelse": "dealern över 21",
   "dur": 4.25
  },
  {
   "id": "dealerbust_2",
   "event": "dealerbust",
   "url": "/media/repliker/dealerbust_2.mp4",
   "text": "Too many for me. The house busts. Congratulations, table.",
   "handelse": "dealern över 21",
   "dur": 4.88
  },
  {
   "id": "dealerbust_3",
   "event": "dealerbust",
   "url": "/media/repliker/dealerbust_3.mp4",
   "text": "And that's over twenty-one for the dealer. Winners all round.",
   "handelse": "dealern över 21",
   "dur": 4.17
  },
  {
   "id": "win_1",
   "event": "win",
   "url": "/media/repliker/win_1.mp4",
   "text": "Well played. That hand is yours.",
   "handelse": "spelare vinner",
   "dur": 3.29
  },
  {
   "id": "win_2",
   "event": "win",
   "url": "/media/repliker/win_2.mp4",
   "text": "You beat me on that one. Congratulations.",
   "handelse": "spelare vinner",
   "dur": 3.29
  },
  {
   "id": "win_3",
   "event": "win",
   "url": "/media/repliker/win_3.mp4",
   "text": "A winning hand. Paid in full.",
   "handelse": "spelare vinner",
   "dur": 3.46
  },
  {
   "id": "push_1",
   "event": "push",
   "url": "/media/repliker/push_1.mp4",
   "text": "Same total. It's a push, your stake stays with you.",
   "handelse": "oavgjort",
   "dur": 4.67
  },
  {
   "id": "push_2",
   "event": "push",
   "url": "/media/repliker/push_2.mp4",
   "text": "We're level. A push, nobody wins and nobody loses.",
   "handelse": "oavgjort",
   "dur": 4.33
  },
  {
   "id": "push_3",
   "event": "push",
   "url": "/media/repliker/push_3.mp4",
   "text": "Push. Your bet comes back.",
   "handelse": "oavgjort",
   "dur": 3.12
  },
  {
   "id": "lose_1",
   "event": "lose",
   "url": "/media/repliker/lose_1.mp4",
   "text": "Dealer wins. That one goes to the house.",
   "handelse": "spelaren förlorar",
   "dur": 3.38
  },
  {
   "id": "lose_2",
   "event": "lose",
   "url": "/media/repliker/lose_2.mp4",
   "text": "Not this time, I'm afraid. The house holds.",
   "handelse": "spelaren förlorar",
   "dur": 3.71
  },
  {
   "id": "lose_3",
   "event": "lose",
   "url": "/media/repliker/lose_3.mp4",
   "text": "Close, but the house has it this round.",
   "handelse": "spelaren förlorar",
   "dur": 3.38
  },
  {
   "id": "peek_1",
   "event": "peek",
   "url": "/media/repliker/peek_1.mp4",
   "text": "One moment while I check for blackjack.",
   "handelse": null,
   "dur": 3.29
  },
  {
   "id": "peek_2",
   "event": "peek",
   "url": "/media/repliker/peek_2.mp4",
   "text": "Dealer checks for blackjack.",
   "handelse": null,
   "dur": 2.5
  },
  {
   "id": "peek_3",
   "event": "peek",
   "url": "/media/repliker/peek_3.mp4",
   "text": "Checking for blackjack. Nothing up my sleeve.",
   "handelse": null,
   "dur": 3.75
  },
  {
   "id": "farewell_1",
   "event": "farewell",
   "url": "/media/repliker/farewell_1.mp4",
   "text": "Thank you for playing. It was a pleasure dealing for you.",
   "handelse": null,
   "dur": 3.75
  },
  {
   "id": "farewell_2",
   "event": "farewell",
   "url": "/media/repliker/farewell_2.mp4",
   "text": "All done for tonight? Thank you, it was lovely having you at the table.",
   "handelse": null,
   "dur": 4.67
  },
  {
   "id": "farewell_3",
   "event": "farewell",
   "url": "/media/repliker/farewell_3.mp4",
   "text": "Good night, and thank you for the company at my table.",
   "handelse": null,
   "dur": 3.62
  },
  {
   "id": "chatter1_1",
   "event": "chatter1",
   "url": "/media/repliker/chatter1_1.mp4",
   "text": "Quiet night at the table. Those are my favourite.",
   "handelse": null,
   "dur": 3.54
  },
  {
   "id": "chatter1_2",
   "event": "chatter1",
   "url": "/media/repliker/chatter1_2.mp4",
   "text": "Eight decks, shuffled fresh every round. Every hand starts from nothing.",
   "handelse": null,
   "dur": 5.75
  },
  {
   "id": "chatter1_3",
   "event": "chatter1",
   "url": "/media/repliker/chatter1_3.mp4",
   "text": "I've dealt a lot of hands at this table. No two ever play out the same.",
   "handelse": null,
   "dur": 5.29
  },
  {
   "id": "chatter2_1",
   "event": "chatter2",
   "url": "/media/repliker/chatter2_1.mp4",
   "text": "Take your time. The cards aren't going anywhere.",
   "handelse": null,
   "dur": 3.62
  },
  {
   "id": "chatter2_2",
   "event": "chatter2",
   "url": "/media/repliker/chatter2_2.mp4",
   "text": "No rush at all. Think it over.",
   "handelse": null,
   "dur": 3.04
  },
  {
   "id": "chatter2_3",
   "event": "chatter2",
   "url": "/media/repliker/chatter2_3.mp4",
   "text": "Whenever you're ready. The decision is yours.",
   "handelse": null,
   "dur": 3.54
  }
 ],
