        "services/game/public/card-presentation/game-cards.js:43 pekar på /media/…",
        "services/game/server.mjs:1088 svarar 404 på /media/ när lokal media är av",
        "apps/web/tools/prepare-platform-ui.mjs kopierar ingen media till frontenden"
      ],
      "fix": "PR #473 (jakob/claude-card-back): bilden byte-identiskt i apps/web/public/images/cards/, href /images/cards/back-scout.png."
    }
