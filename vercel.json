{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "**": false,
      "*": false,
      "main": true
    }
  },
  "services": {
    "speech": {
      "root": "apps/speech",
      "framework": "node",
      "entrypoint": "server.mjs",
      "installCommand": "npm ci --ignore-scripts",
      "buildCommand": "npm run build",
      "functions": { "server.mjs": { "maxDuration": 600 } }
    },
    "web": {
      "root": "apps/web",
      "framework": "nextjs",
      "buildCommand": "npm run build",
      "functions": {
        "api/platform-speech-stream.mjs": { "maxDuration": 300 },
        "api/platform-lipsync-worker.mjs": { "maxDuration": 600 },
        "api/platform-moving-speech-stream.mjs": { "maxDuration": 300 }
      }
    },
    "studio": {
      "root": "apps/studio",
      "framework": "nextjs",
      "buildCommand": "npm run build",
      "routes": [
        {
          "src": "^/(control|partner|admin|lobby)$",
          "dest": "/studio/$1",
          "transforms": [{ "type": "request.path", "op": "set", "args": "/studio/$1" }],
          "continue": true
        },
        {
          "src": "^/(control|partner|admin|lobby)/(.*)$",
          "dest": "/studio/$1/$2",
          "transforms": [{ "type": "request.path", "op": "set", "args": "/studio/$1/$2" }],
          "continue": true
        }
      ]
    }
  },
  "rewrites": [
    { "source": "/speech-stream", "destination": { "service": "speech" } },
    { "source": "/lipsync-worker", "destination": { "service": "speech" } },
    { "source": "/moving-speech-stream", "destination": { "service": "speech" } },
    { "source": "/lipsync-moving/:path*", "destination": { "service": "speech" } },
    { "source": "/shared-room/:path*", "destination": { "service": "speech" } },
    { "source": "/studio/:path*", "destination": { "service": "studio" } },
    { "source": "/control/:path*", "destination": { "service": "studio" } },
    { "source": "/partner/:path*", "destination": { "service": "studio" } },
    { "source": "/admin/:path*", "destination": { "service": "studio" } },
    { "source": "/lobby/:path*", "destination": { "service": "studio" } },
    { "source": "/", "destination": { "service": "web", "path": "/" } },
    { "source": "/(.*)", "destination": { "service": "web" } }
  ]
}
