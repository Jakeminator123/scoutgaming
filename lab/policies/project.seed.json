  "events": [
    {
      "id": "speak.goodluck",
      "label": "Lycka till",
      "description": "Startfrasen från presentation[]; tidigare språkönskemål är en separat, simulerad preferens.",
      "sourceType": "speak",
      "sourceRef": "web/partner-presentation.mjs#presentationEvents",
      "sourceStatus": "verified",
      "match": {
        "line": "goodluck"
      },
      "exampleEvent": {
        "type": "speak",
        "line": "goodluck",
        "blocking": true
      }
    },
    {
      "id": "speak.insurance",
      "label": "Försäkring erbjuds",
      "description": "Spelmotorn har publicerat insurance; labbet ändrar bara hur informationen presenteras.",
      "sourceType": "speak",
      "sourceRef": "web/partner-presentation.mjs#presentationEvents",
      "sourceStatus": "verified",
      "match": {
        "line": "insurance"
      },
      "exampleEvent": {
        "type": "speak",
        "line": "insurance"
      }
    },
    {
      "id": "speak.double",
      "label": "Dubbling bekräftad",
      "description": "Frasen double kommer efter accepterad spelhandling, inte som ett råd att dubbla.",
      "sourceType": "speak",
      "sourceRef": "web/partner-presentation.mjs#presentationEvents",
      "sourceStatus": "verified",
      "match": {
        "line": "double"
      },
      "exampleEvent": {
        "type": "speak",
        "line": "double"
      }
    },
    {
      "id": "speak.other",
      "label": "Övrig spelreplik",
      "description": "Labbgrupp för flera publicerade line-namn, inklusive resultat och placebets. Exakt källreplik bevaras. En gemensam labbvideo är inte ett godkänt talpaket för alla dessa repliker.",
      "sourceType": "speak",
      "sourceRef": "web/partner-presentation.mjs#presentationEvents",
      "sourceStatus": "verified",
      "match": {},
      "exampleEvent": {
        "type": "speak",
        "line": "placebets"
      }
    },
    {
      "id": "deal.player.left",
      "label": "Kort till vänster",
      "description": "Publicerad deal med clip.action=deal-left, box 0–1. Varianten behåller samma destination.",
      "sourceType": "deal",
      "sourceRef": "web/partner-presentation.mjs#presentationEvents",
      "sourceStatus": "verified",
      "match": {
        "clip.action": "deal-left"
      },
      "exampleEvent": {
        "type": "deal",
        "to": "box",
        "box": 0,
        "handIndex": 0,
        "card": {
          "r": "8",
          "s": "♣"
        },
        "faceDown": false,
        "shoeDraw": 2,
        "clip": {
          "action": "deal-left"
        }
      }
    },
    {
      "id": "deal.player.centre",
      "label": "Kort till mitten",
      "description": "Publicerad deal med clip.action=deal-centre, box 2–4. Labbrörelsen är en platshållare, inte kalibrerad video.",
      "sourceType": "deal",
      "sourceRef": "web/partner-presentation.mjs#presentationEvents",
      "sourceStatus": "verified",
      "match": {
        "clip.action": "deal-centre"
      },
      "exampleEvent": {
        "type": "deal",
        "to": "box",
        "box": 3,
        "handIndex": 0,
        "card": {
          "r": "A",
          "s": "♥"
        },
        "faceDown": false,
        "shoeDraw": 3,
        "clip": {
          "action": "deal-centre"
        }
      }
    },
    {
      "id": "deal.player.right",
      "label": "Kort till höger",
      "description": "Publicerad deal med clip.action=deal-right, box 5–6. Varianten behåller samma kort och destination.",
      "sourceType": "deal",
      "sourceRef": "web/partner-presentation.mjs#presentationEvents",
      "sourceStatus": "verified",
      "match": {
        "clip.action": "deal-right"
      },
      "exampleEvent": {
        "type": "deal",
        "to": "box",
        "box": 6,
        "handIndex": 0,
        "card": {
          "r": "4",
          "s": "♦"
        },
        "faceDown": false,
        "shoeDraw": 4,
        "clip": {
          "action": "deal-right"
        }
      }
    },
    {
      "id": "deal.dealer",
      "label": "Kort till croupiern",
      "description": "Även hålkortet kommer som deal. När faceDown=true projiceras card alltid till null.",
      "sourceType": "deal",
      "sourceRef": "web/partner-presentation.mjs#presentationEvents",
      "sourceStatus": "verified",
      "match": {
        "to": "dealer"
      },
      "exampleEvent": {
        "type": "deal",
        "to": "dealer",
        "box": null,
        "handIndex": null,
        "card": null,
        "faceDown": true,
        "shoeDraw": 5,
        "clip": {
          "action": "deal-dealer"
        }
      }
    },
    {
      "id": "reveal.dealer",
      "label": "Visa croupierns kort",
      "description": "reveal innehåller först nu det publicerade hålkortets rank och färg.",
      "sourceType": "reveal",
      "sourceRef": "web/partner-presentation.mjs#presentationEvents",
      "sourceStatus": "verified",
      "match": {},
      "exampleEvent": {
        "type": "reveal",
        "to": "dealer",
        "card": {
          "r": "K",
          "s": "♠"
        },
        "shoeDraw": 5
      }
    },
    {
      "id": "turn.player",
      "label": "Spelarens tur",
      "description": "turn markerar box, handIndex och legalActions som motorn redan har beslutat.",
      "sourceType": "turn",
      "sourceRef": "web/partner-presentation.mjs#presentationEvents",
      "sourceStatus": "verified",
      "match": {},
      "exampleEvent": {
        "type": "turn",
        "box": 3,
        "handIndex": 0,
        "legalActions": [
          "hit",
          "stand",
          "double"
        ]
      }
    },
    {
      "id": "settle.blackjack",
      "label": "Publicerad blackjack",
      "description": "Semantisk mappning av settle.hands[].outcome=blackjack. Inga framtida kort eller odds används.",
      "sourceType": "settle",
      "sourceRef": "web/partner-presentation.mjs#presentationEvents",
      "sourceStatus": "verified",
      "match": {
        "hands.outcome": {
          "includes": "blackjack"
        }
      },
      "exampleEvent": {
        "type": "settle",
        "dealerTotal": 18,
        "dealerBlackjack": false,
        "hands": [
          {
            "box": 3,
            "outcome": "blackjack"
          }
        ]
      }
    },
    {
      "id": "settle.dealerBust",
      "label": "Croupiern över 21",
      "description": "Semantisk mappning av det publicerade dealerTotal. Enskilda handresultat bevaras.",
      "sourceType": "settle",
      "sourceRef": "web/partner-presentation.mjs#presentationEvents",
      "sourceStatus": "verified",
      "match": {
        "dealerTotal": {
          "gt": 21
        }
      },
      "exampleEvent": {
        "type": "settle",
        "dealerTotal": 23,
        "dealerBlackjack": false,
        "hands": [
          {
            "box": 3,
            "outcome": "win"
          }
        ]
      }
    },
    {
      "id": "settle.win",
      "label": "Publicerad vinst",
      "description": "Minst en publicerad hand har outcome=win. Detta är presentation, inte spelråd.",
      "sourceType": "settle",
      "sourceRef": "web/partner-presentation.mjs#presentationEvents",
      "sourceStatus": "verified",
      "match": {
        "hands.outcome": {
          "includes": "win"
        }
      },
      "exampleEvent": {
        "type": "settle",
        "dealerTotal": 18,
        "dealerBlackjack": false,
        "hands": [
          {
            "box": 3,
            "outcome": "win"
          }
        ]
      }
    },
    {
      "id": "settle.push",
      "label": "Oavgjort",
      "description": "Labbgrupp när alla publicerade handresultat är push. Motorns separata speak.line bevaras; exempelvis kan dealer-blackjack ge denna resultatgrupp men en annan talrad.",
      "sourceType": "settle",
      "sourceRef": "web/partner-presentation.mjs#presentationEvents",
      "sourceStatus": "verified",
      "match": {
        "hands.outcome": {
          "all_eq": "push"
        }
      },
      "exampleEvent": {
        "type": "settle",
        "dealerTotal": 20,
        "dealerBlackjack": false,
        "hands": [
          {
            "box": 3,
            "outcome": "push"
          }
        ]
      }
    },
    {
      "id": "settle.other",
      "label": "Övrigt resultat / förlust",
      "description": "Labbets fallback när tidigare resultatgrupper inte matchar. Blandade händer kan träffa tidigare grupper. Exakta handresultat och motorns separata speak.line bevaras.",
      "sourceType": "settle",
      "sourceRef": "web/partner-presentation.mjs#presentationEvents",
      "sourceStatus": "verified",
      "match": {},
      "exampleEvent": {
        "type": "settle",
        "dealerTotal": 20,
        "dealerBlackjack": false,
        "hands": [
          {
            "box": 3,
            "outcome": "lose"
          }
        ]
      }
    },
    {
      "id": "idle.ready",
      "label": "Bordet väntar",
      "description": "Publicerad idle. En återvändande spelare är simulerad kontext tills en riktig livscykelkoppling finns.",
      "sourceType": "idle",
      "sourceRef": "web/partner-presentation.mjs#presentationEvents",
      "sourceStatus": "verified",
      "match": {},
      "exampleEvent": {
        "type": "idle"
      }
    }
