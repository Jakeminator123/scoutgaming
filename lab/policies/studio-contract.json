  "terms": [
    {
      "id": "event",
      "label": "Event",
      "definition": "En publicerad presentation från spelet: speak, deal, reveal, turn, settle eller idle."
    },
    {
      "id": "group",
      "label": "Eventgrupp",
      "definition": "En av labbets 16 grupper. Inte ett nytt event i spelmotorn."
    },
    {
      "id": "situation",
      "label": "Situation",
      "definition": "Exakt målplats eller replik inom en eventgrupp."
    },
    {
      "id": "line",
      "label": "Linje",
      "definition": "En dealers uppsättning standard och alternativ för en eventgrupp."
    },
    {
      "id": "variant",
      "label": "Variant",
      "definition": "Standard eller alternativ inom linjen. Äger urvalstillåtelser och extra villkor."
    },
    {
      "id": "video",
      "label": "Videofil",
      "definition": "Råfil med stabilt video-ID och hash. Kategorisering är inte visuellt godkännande."
    },
    {
      "id": "trigger",
      "label": "Trigger",
      "definition": "Extra villkor för ett alternativ. Skapar inte ett nytt spel-event."
    },
    {
      "id": "schema",
      "label": "Schema",
      "definition": "Maskinläsbart format: tillåtna fält och värden."
    },
    {
      "id": "manifest",
      "label": "Manifest",
      "definition": "Register över identiteter, kategorier och referenser."
    },
    {
      "id": "policy",
      "label": "Policy",
      "definition": "Regler för när ett tillåtet alternativ får väljas."
    }
  ],
