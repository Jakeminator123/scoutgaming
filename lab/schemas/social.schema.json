{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Croupier lab — editable social expression policy (not an engine event)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "revision", "trigger", "response", "cooldownMs"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "revision": { "type": "string", "minLength": 1, "maxLength": 100 },
    "trigger": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "label", "enabled", "directive", "threshold"],
      "properties": {
        "id": { "const": "social.ledsen" },
        "label": { "type": "string", "minLength": 1, "maxLength": 80 },
        "enabled": { "type": "boolean" },
        "directive": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "threshold": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "response": {
      "type": "object", "additionalProperties": false,
      "required": ["mode", "fixedText"],
      "properties": {
        "mode": { "enum": ["fixed", "free"] },
        "fixedText": { "type": "string", "maxLength": 500 }
      },
      "allOf": [{ "if": { "properties": { "mode": { "const": "fixed" } } }, "then": { "properties": { "fixedText": { "minLength": 1 } } } }]
    },
    "cooldownMs": { "type": "integer", "minimum": 0, "maximum": 300000 }
  }
}
