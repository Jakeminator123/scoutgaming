{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://croupier.local/schemas/lab-video-manifest.schema.json",
  "title": "Croupier lab video manifest v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "source",
    "families",
    "items"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "source": {
      "const": "emil/dealklipp-v1"
    },
    "families": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "$ref": "#/$defs/family"
      }
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "$ref": "#/$defs/item"
      }
    }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
    },
    "family": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "dealerId",
        "eventId",
        "situation",
        "playbackType",
        "standardIds",
        "variantIds"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*/[a-z][a-z0-9._-]*/[a-z][a-z0-9_-]*$",
          "maxLength": 160
        },
        "dealerId": {
          "const": "astrid"
        },
        "eventId": {
          "enum": [
            "speak.goodluck",
            "speak.insurance",
            "speak.double",
            "speak.other",
            "deal.player.left",
            "deal.player.centre",
            "deal.player.right",
            "deal.dealer",
            "idle.ready"
          ]
        },
        "situation": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,79}$"
        },
        "playbackType": {
          "enum": [
            "once",
            "idle-pool"
          ]
        },
        "standardIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/uuid"
          }
        },
        "variantIds": {
          "type": "array",
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/uuid"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "playbackType": {
                "const": "once"
              }
            }
          },
          "then": {
            "properties": {
              "standardIds": {
                "minItems": 1,
                "maxItems": 1
              }
            }
          }
        }
      ]
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "familyId",
        "role",
        "relativePath",
        "extension",
        "size",
        "sha256"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/uuid"
        },
        "familyId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*/[a-z][a-z0-9._-]*/[a-z][a-z0-9_-]*$",
          "maxLength": 160
        },
        "role": {
          "enum": [
            "standard",
            "variant"
          ]
        },
        "relativePath": {
          "type": "string",
          "maxLength": 240,
          "anyOf": [
            {
              "pattern": "^deal/deal_pos(?:[1-7]|dealer)/(?:deal_pos(?:[1-7]|dealer)\\.mp4|variant/[a-z0-9][a-z0-9._-]*\\.mp4)$"
            },
            {
              "pattern": "^repliker/[a-z][a-z0-9_-]*/(?:[a-z][a-z0-9_-]*\\.mp4|variant/[a-z0-9][a-z0-9._-]*\\.mp4)$"
            },
            {
              "pattern": "^idle/(?:idle_(?:blink|breath|cheek|glance|still)_f[0-9]+_s[0-9]+\\.mp4|variant/idle_[a-z0-9_-]+_f[0-9]+_s[0-9]+\\.mp4)$"
            }
          ]
        },
        "extension": {
          "const": "mp4"
        },
        "size": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  }
}
