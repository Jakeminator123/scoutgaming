# Local studio only. Never put secrets in NEXT_PUBLIC_* variables.
# Optional override; the existing local archive is discovered read-only.
# LAB_VIDEO_ARCHIVE=C:/Users/jakem/CroupierAssets/bettalotto-generations
# LAB_STUDIO_DATA_DIR=C:/path/to/isolated/studio-data
# OpenClaw/Render connection (separate service and credentials from Bettalotto).
# Existing OpenClaw/Render settings are read server-side from the repo root .env.
# LAB_REMOTE_URL=https://croupier-lab-director.onrender.com
# LAB_REMOTE_TOKEN=the-director-LAB_API_TOKEN
# OPENCLAW_TIMEOUT_MS=8000
# A revised local tree is never silently published to Render.

# Bettalotto Partner API: optional read-only event observer. Put these server-side
# settings in lab/.env.local, then restart the lab. Opening the log does not connect;
# the user explicitly starts observation. No play/wallet commands are sent.
# BETTALOTTO_PARTNER_BASE_URL=https://bettalotto.se
# BETTALOTTO_PARTNER_KEY_ID=ck_live_replace-with-the-complete-public-api-key
# BETTALOTTO_PARTNER_SECRET=cs_replace-with-the-matching-secret
# BETTALOTTO_PARTNER_PLAYER_ID=the-exact-partner-player-id
# KEY_ID means the public ck_live_* key, not the backoffice database UUID.
# The existing /api/v1/events endpoint requires the key's play scope even for
# reading. It observes only that key + player channel, with no replay/history.
# A backoffice login or LAB_REMOTE_TOKEN does not authenticate this connection.
# BETTALOTTO_API has no automatic interpretation as a key or secret.
# Deprecated LAB_PARTNER_* names remain fallbacks; BETTALOTTO_PARTNER_* wins.
