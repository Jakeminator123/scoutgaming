#!/bin/sh
# Keep this hook LF-only; .gitattributes enforces it on Windows checkouts.
set -eu
# One registry for full local checks and separately visible CI suites.
suite=${1:-all}
if [ "$#" -gt 1 ]; then echo 'Usage: pre-commit-full [suite]' >&2; exit 2; fi
case "$suite" in
  all|studio|admin|contracts|database|presentation|access|speech|gameplay|engine|container) ;;
  *) echo "Unknown regression suite: $suite" >&2; exit 2 ;;
esac
run_check() {
  selected=$1
  name=$2
  seconds=$3
  shift 3
  if [ "$suite" = all ] || [ "$suite" = "$selected" ]; then
    node tools/regression-group.mjs "$selected/$name" "$seconds" "$@"
  fi
}
run_node_tests() {
  selected=$1
  name=$2
  shift 2
  seconds=180
  if [ "$selected" = studio ]; then seconds=360; fi
  # The pinned-image Docker build and real process regression (900s test).
  if [ "$selected" = container ]; then seconds=960; fi
  run_check "$selected" "$name" "$seconds" node --test --test-concurrency=4 --test-reporter=spec "$@"
}
