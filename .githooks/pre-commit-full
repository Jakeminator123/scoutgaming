#!/bin/sh
# Keep this hook LF-only; .gitattributes enforces it on Windows checkouts.
set -eu
# Bound local Windows test workers; CI retains its existing defaults.
test_worker_limit=
if [ "${OS:-}" = "Windows_NT" ] && [ -z "${CI:-}" ]; then
  test_worker_limit=--test-concurrency=4
fi
# Optional passive CI reporter: the same tests run once, with sanitized receipts.
system_map_report_index=0
run_node_tests() {
  if [ -n "${CROUPIER_SYSTEM_MAP_EVIDENCE_DIR:-}" ]; then
    system_map_report_index=$((system_map_report_index + 1))
    mkdir -p "$CROUPIER_SYSTEM_MAP_EVIDENCE_DIR"
    node --test $test_worker_limit --test-reporter=tap --test-reporter-destination=stdout \
      --test-reporter=./tools/system-map-evidence.mjs \
      --test-reporter-destination="$CROUPIER_SYSTEM_MAP_EVIDENCE_DIR/$system_map_report_index.jsonl" "$@"
  else
    node --test $test_worker_limit "$@"
  fi
}
