# Applies only when the repository root is the Docker build context.
# The existing OpenClaw images use services/openclaw/lab/.dockerignore instead.

# Git, local agent state, and CI/development metadata.
.git
.github
.gitlab
.githooks
.agents
.cursor
.croupier-inbox
agent-talk/state.json*
agent-talk/write.lock
arkiv
**/.DS_Store
**/*.log

# Rebuild dependencies and Next output inside a controlled image build.
node_modules
**/node_modules
**/test-results
**/coverage

# Never send local keys or mutable player/studio data to a builder.
.env
.env.*
**/.env
**/.env.*
inbox-token.txt
_ENVIROMENT-INFO.md
**/*.pem
**/*.p12
**/*.pfx
open-claw/lab/data
services/openclaw/lab/data

# Published runtime media use media/**/runtime; public code stays in web/public.
# Source, staging and review material is preserved outside runtime images.
media/.migration
media/**/source
media/**/staging
media/**/review
# Production reads these registers from scoped Neon. Keep authoring files in
# the checkout, but exclude them from COPY . . in the cloud image.
media/layout.json
media/blob-index.json
media/catalog
# Retired 3D source trees, removed 2026-10-12. The names stay so a restored
# checkout is not copied into an image.
assets/astrid-3d
assets/blackjack-3d
content/staging
content/bake
content/raw-all
content/raw-speak
content/raw-speak2
content/raw-super
content/raw2
content/encoded2
emil/astrid-demo-v3-reference

# Documentation, review sources, and tests are not runtime inputs.
docs
test
open-claw/lab/test
services/openclaw/lab/test
design-kit
reference

# Relocated Studio: retain old private/build guards for files left in place.
apps/studio/.next
apps/studio/.next-probe
apps/studio/tsconfig.tsbuildinfo
apps/studio/test
