# Root build context: ops/cloud/Dockerfile.game (croupier-v3) only. It copies
# explicit paths; this file keeps everything else out of the context.
# The Director uses services/openclaw/lab/Dockerfile.dockerignore, and the
# Gateway and GPU workers use .dockerignore in their own build contexts.

# Git, local agent state and CI/development metadata.
.git
.github
.githooks
.claude
.cursor
.vercel
arkiv
random-stuff-jakob
open-claw
**/.DS_Store
**/*.log

# Dependencies are installed inside the image.
node_modules
**/node_modules
**/test-results
**/coverage

# Never send local keys or mutable player data to a builder.
.env
.env.*
**/.env
**/.env.*
**/*.pem
**/*.p12
**/*.pfx

# Not runtime inputs: media bytes come from Blob, registers from Neon, and
# Studio, documentation, tests and migration notes are never copied.
media
docs
test
apps
migrering
