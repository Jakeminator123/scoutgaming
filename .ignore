# Ordinary ripgrep discovery; Git/build inputs are unchanged.
/arkiv/
# Not a copy of .cursorignore. Heavy tracked media stays hidden from rg.
# .cursorindexingignore alone keeps that text out of the Cursor index.
# Retired private archive: never read or re-index.
/random-stuff-jakob/jakob-docs/arkiv/
/random-stuff-jakob/jakob-docs/KEVIN-ATKOMST-PRIVAT.txt

# Dependencies and generated cache (not source dist/public directories).
node_modules/
.next/
.nuxt/
.cache/
.turbo/
coverage/
playwright-report/
test-results/
__pycache__/
.venv/
.lipsync-venv/
vendor/
*.tsbuildinfo
*.log

# Local secrets, state and logs.
.git/
.env
.env.*
!.env.example
!.env.*.example
.croupier-inbox/
/agent-talk/state.json
/agent-talk/write.lock
/media/.migration/

# Binary media/data: JSON manifests, calibration and source stay searchable.
*.mp4
*.mov
*.webm
*.mkv
*.mp3
*.wav
*.ogg
*.flac
*.png
*.jpg
*.jpeg
*.webp
*.gif
*.glb
*.gltf
*.blend
*.fbx
*.obj
*.stl
*.usdz
*.bin
*.h264
*.webpseq
*.zip
*.7z
*.sqlite
*.sqlite3
*.db

# Large source/staging metadata and generated layout stay available for explicit reads.
/media/**/source/
/media/**/staging/
/media/layout.json
/media/blob-index.json

# Canonical recovery archive; inspect only when needed.
/arkiv/

# Retired local roots: never stage if an old checkout still has them
/lab/data/
/apps/studio/data/
/web/data/
/services/game/data/

# Director/Gateway local state (the Director adapter defaults to open-claw/lab).
/open-claw/lab/data/
/open-claw/lab/runtime/
/open-claw/lab/media/*
/services/openclaw/lab/data/
