# Search only: ripgrep and the Grep tools in Claude Code and Cursor.
# Git, builds and deploys are unaffected by this file.
# ripgrep already skips everything in .gitignore (node_modules, .env*, .vercel,
# local data, logs, build output), so this file lists only TRACKED files that
# are noise for text search. Inventories and cleanup start from `git ls-files`,
# which ignores this file and shows every tracked file.

# Tracked binary media, 3D files and archives.
*.mp4
*.mov
*.webm
*.mkv
*.mp3
*.wav
*.ogg
*.flac
*.png
*.jpg
*.jpeg
*.webp
*.gif
*.glb
*.gltf
*.blend
*.fbx
*.obj
*.stl
*.usdz
*.bin
*.h264
*.webpseq
*.zip
*.7z
*.sqlite
*.sqlite3
*.db

# Large generated media registers; open them explicitly when needed.
/media/layout.json
/media/blob-index.json
# Raw media source and staging material.
/media/**/source/
/media/**/staging/
# Frozen Kevin import source: about 190 KB of JSON on one line. Open it explicitly.
/apps/studio/lib/dealer-import-kevin-source-paow.json
