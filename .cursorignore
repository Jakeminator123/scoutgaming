# Cursor discovery/access exclusions; files stay available to builds.
# These are not filesystem permissions for Codex, terminal or MCP tools.
/arkiv/

# Dependencies and generated cache (not source dist/public directories).
node_modules/
.next/
.nuxt/
.cache/
.turbo/
coverage/
playwright-report/
test-results/
__pycache__/
.venv/
.lipsync-venv/
vendor/
*.tsbuildinfo
*.log

# Local secrets, state and logs.
.git/
.env
.env.*
!.env.example
!.env.*.example
.croupier-inbox/
/agent-talk/state.json
/agent-talk/write.lock

# Binary media/data: JSON manifests, calibration and source stay searchable.
*.mp4
*.mov
*.webm
*.mkv
*.mp3
*.wav
*.ogg
*.flac
*.png
*.jpg
*.jpeg
*.webp
*.gif
*.glb
*.gltf
*.blend
*.fbx
*.obj
*.stl
*.usdz
*.bin
*.h264
*.webpseq
*.zip
*.7z
*.sqlite
*.sqlite3
*.db

# Local migration journals stay hidden. Heavy tracked project text is not
# listed here. .cursorindexingignore is legacy/version-dependent; do not
# assume Instant Grep honors its index-only exclusions. See AGENTS.md.
/media/.migration/

# Canonical recovery archive; inspect only when needed.
/arkiv/

# Director/Gateway local state (the Director adapter defaults to open-claw/lab).
/open-claw/lab/data/
/open-claw/lab/runtime/
/open-claw/lab/media/*
/services/openclaw/lab/data/
