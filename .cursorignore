# Cursor AI access exclusions for secrets and private local state.
# Terminal/MCP access is not blocked by this file; it is not an OS permission boundary.
# Build output is in .gitignore; .ignore reduces ripgrep search noise.
.env*
!.env.example
*.pem
*.p12
*.pfx
.vercel/
.claude/
/arkiv/
/random-stuff-jakob/
/inbox/local-device.json
/inbox/local-device.json.*.tmp
/open-claw/
/services/openclaw/lab/data/
/apps/studio/data/
