{
  "compilerOptions": {
    "target": "ES2022", "lib": ["dom", "dom.iterable", "esnext"], "strict": true,
    "skipLibCheck": true, "noEmit": true, "allowJs": true, "esModuleInterop": true, "module": "esnext",
    "moduleResolution": "bundler", "jsx": "react-jsx",
    "paths": { "@/*": ["./*"], "next/link": ["../runtime/navigation.tsx"], "next/navigation": ["../runtime/navigation.tsx"] }
  },
  "include": ["entry.tsx", "../runtime"]
}
