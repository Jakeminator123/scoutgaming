{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "node build.mjs",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ]
    },
    {
      "source": "/((?!frontend-preview/).*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "default-src 'none'; style-src 'self'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'" }
      ]
    },
    {
      "source": "/frontend-preview/(.*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; media-src 'self' blob:; connect-src 'self' wss:; worker-src 'self' blob:; base-uri 'self'; frame-ancestors 'none'; form-action 'self'" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "private, no-store" }]
    },
    {
      "source": "/chat",
      "headers": [{ "key": "Cache-Control", "value": "private, no-store" }]
    }
  ],
  "rewrites": [
    { "source": "/api/auth/session", "destination": "__ISOLATED_BACKEND_ORIGIN__/api/auth/session" },
    { "source": "/api/auth/login", "destination": "__ISOLATED_BACKEND_ORIGIN__/api/auth/login" },
    { "source": "/api/auth/logout", "destination": "__ISOLATED_BACKEND_ORIGIN__/api/auth/logout" },
    { "source": "/api/auth/player/login", "destination": "__ISOLATED_BACKEND_ORIGIN__/api/auth/player/login" },
    { "source": "/api/auth/player/register", "destination": "__ISOLATED_BACKEND_ORIGIN__/api/auth/player/register" },
    { "source": "/api/player", "destination": "__ISOLATED_BACKEND_ORIGIN__/api/player" },
    { "source": "/api/table", "destination": "__ISOLATED_BACKEND_ORIGIN__/api/table" },
    { "source": "/api/deposit", "destination": "__ISOLATED_BACKEND_ORIGIN__/api/deposit" },
    { "source": "/api/balance", "destination": "__ISOLATED_BACKEND_ORIGIN__/api/balance" },
    { "source": "/api/currency", "destination": "__ISOLATED_BACKEND_ORIGIN__/api/currency" },
    { "source": "/api/bo/config", "destination": "__ISOLATED_BACKEND_ORIGIN__/api/bo/config" },
    { "source": "/api/presentation/config", "destination": "__ISOLATED_BACKEND_ORIGIN__/api/presentation/config" },
    { "source": "/api/presentation/select", "destination": "__ISOLATED_BACKEND_ORIGIN__/api/presentation/select" },
    { "source": "/api/presentation/idle-advice", "destination": "__ISOLATED_BACKEND_ORIGIN__/api/presentation/idle-advice" },
    { "source": "/api/presentation/videos/:id", "destination": "__ISOLATED_BACKEND_ORIGIN__/api/presentation/videos/:id" },
    { "source": "/api/chat/memory", "destination": "__ISOLATED_BACKEND_ORIGIN__/api/chat/memory" },
    { "source": "/api/chat/memory/forget", "destination": "__ISOLATED_BACKEND_ORIGIN__/api/chat/memory/forget" },
    { "source": "/api/probe/presence", "destination": "__ISOLATED_BACKEND_ORIGIN__/api/probe/presence" },
    { "source": "/api/probe/forget", "destination": "__ISOLATED_BACKEND_ORIGIN__/api/probe/forget" },
    { "source": "/api/probe/decide", "destination": "__ISOLATED_BACKEND_ORIGIN__/api/probe/decide" },
    { "source": "/api/probe/receipt", "destination": "__ISOLATED_BACKEND_ORIGIN__/api/probe/receipt" },
    { "source": "/api/probe/test", "destination": "__ISOLATED_BACKEND_ORIGIN__/api/probe/test" },
    { "source": "/api/astrid/observation", "destination": "__ISOLATED_BACKEND_ORIGIN__/api/astrid/observation" },
    { "source": "/api/astrid/transcription", "destination": "__ISOLATED_BACKEND_ORIGIN__/api/astrid/transcription" },
    { "source": "/chat", "destination": "__ISOLATED_BACKEND_ORIGIN__/chat" },
    { "source": "/assets/table.png", "destination": "__ISOLATED_BACKEND_ORIGIN__/assets/table.png" },
    { "source": "/assets/shoe.png", "destination": "__ISOLATED_BACKEND_ORIGIN__/assets/shoe.png" },
    { "source": "/assets/cardback.png", "destination": "__ISOLATED_BACKEND_ORIGIN__/assets/cardback.png" },
    { "source": "/kevin-cards/back-scout.png", "destination": "__ISOLATED_BACKEND_ORIGIN__/kevin-cards/back-scout.png" },
    { "source": "/assets/room-extended.png", "destination": "__ISOLATED_BACKEND_ORIGIN__/assets/room-extended.png" },
    { "source": "/scene.jpg", "destination": "__ISOLATED_BACKEND_ORIGIN__/scene.jpg" },
    { "source": "/dealer-fallback.png", "destination": "__ISOLATED_BACKEND_ORIGIN__/dealer-fallback.png" },
    { "source": "/sfx/ambience.mp3", "destination": "__ISOLATED_BACKEND_ORIGIN__/sfx/ambience.mp3" },
    { "source": "/dealer/supervisor.webm", "destination": "__ISOLATED_BACKEND_ORIGIN__/dealer/supervisor.webm" },
    { "source": "/dealers/astrid/scene.png", "destination": "__ISOLATED_BACKEND_ORIGIN__/dealers/astrid/scene.png" },
    { "source": "/dealers/astrid/table.png", "destination": "__ISOLATED_BACKEND_ORIGIN__/dealers/astrid/table.png" },
    { "source": "/dealers/astrid/poster.jpg", "destination": "__ISOLATED_BACKEND_ORIGIN__/dealers/astrid/poster.jpg" },
    { "source": "/dealers/astrid/dealing-cues.json", "destination": "__ISOLATED_BACKEND_ORIGIN__/dealers/astrid/dealing-cues.json" },
    { "source": "/dealers/astrid/audio/en/bank.json", "destination": "__ISOLATED_BACKEND_ORIGIN__/dealers/astrid/audio/en/bank.json" },
    { "source": "/dealers/astrid/actor/room.jpg", "destination": "__ISOLATED_BACKEND_ORIGIN__/dealers/astrid/actor/room.jpg" },
    { "source": "/dealer/poster.jpg", "destination": "__ISOLATED_BACKEND_ORIGIN__/dealer/poster.jpg" },
    { "source": "/dealers/amira/poster.jpg", "destination": "__ISOLATED_BACKEND_ORIGIN__/dealers/amira/poster.jpg" },
    { "source": "/dealers/mei/poster.jpg", "destination": "__ISOLATED_BACKEND_ORIGIN__/dealers/mei/poster.jpg" },
    { "source": "/dealers/dragge/poster.jpg", "destination": "__ISOLATED_BACKEND_ORIGIN__/dealers/dragge/poster.jpg" },
    { "source": "/dealers/paow/poster.jpg", "destination": "__ISOLATED_BACKEND_ORIGIN__/dealers/paow/poster.jpg" }
  ]
}
