# The BO session exchange issues a host-only game cookie on the canonical host.
www.bettalotto.se {
    redir https://bettalotto.se{uri} permanent
}

bettalotto.se {
    # Existing partner API/documentation/media access is unchanged.
    @partner path /api/v1/* /docs/* /dealers/* /dealer/* /assets/*
    handle @partner {
        encode zstd gzip
        reverse_proxy 127.0.0.1:4173
    }
    # Each endpoint enforces its own authentication and origin checks.
    @signin path /api/auth/* /api/bo/* /bo /bo/*
    handle @signin {
        reverse_proxy 127.0.0.1:4173
    }
    handle {
        forward_auth 127.0.0.1:4173 {
            uri /api/auth/access
        }
        encode zstd gzip
        reverse_proxy 127.0.0.1:4173
    }
}
