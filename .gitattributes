# Git Bash reads these files directly; CRLF can disable `set -e` and corrupt paths.
*.sh text eol=lf
.githooks/* text eol=lf
# The deterministic manifest check compares its canonical LF serialization.
# The layout records exact migration hashes, including calibration/source bytes.
# Keep the same bytes on Linux and Windows checkouts.
media/** -text
media/layout.json text eol=lf

# Frozen migration fixtures are checked against the original Git blob bytes.
test/fixtures/kevin-5aa7ed1/** text eol=lf
