{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DirectorAdviceV1 — untrusted model output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "opportunityId",
    "policyRevision",
    "catalogRevision",
    "contextDigest",
    "candidateId"
  ],
  "properties": {
    "schemaVersion": {
      "const": "director-advice.v1"
    },
    "opportunityId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "policyRevision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "catalogRevision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "contextDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "candidateId": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
