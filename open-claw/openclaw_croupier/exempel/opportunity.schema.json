{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PresentationOpportunityV1 — pilot proposal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "opportunityId",
    "tableId",
    "roundId",
    "eventId",
    "policyRevision",
    "catalogRevision",
    "showEvent",
    "publicSeq",
    "expectedShowSeq",
    "epoch",
    "expiresAtMs",
    "contextDigest",
    "context",
    "allowedCandidates"
  ],
  "properties": {
    "schemaVersion": {
      "const": "presentation-opportunity.v1"
    },
    "opportunityId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "tableId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "roundId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "eventId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "policyRevision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "catalogRevision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "showEvent": {
      "enum": [
        "show.hand.think",
        "show.deal.watch",
        "show.line.chatter",
        "show.line.win",
        "show.line.lose"
      ]
    },
    "publicSeq": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "expectedShowSeq": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "epoch": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "expiresAtMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "contextDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "personaId",
        "locale",
        "publicSummary",
        "chatText",
        "senderSeat"
      ],
      "properties": {
        "personaId": {
          "type": "string",
          "enum": [
            "astrid"
          ]
        },
        "locale": {
          "const": "sv-SE"
        },
        "publicSummary": {
          "type": "string",
          "maxLength": 500
        },
        "chatText": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 500
        },
        "senderSeat": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 6
        }
      }
    },
    "allowedCandidates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "description"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          }
        }
      }
    }
  }
}
