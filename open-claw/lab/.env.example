# Add the values you need to Croupier's existing root .env (never commit it).
# Local server -> an existing OpenClaw Gateway. This is GATEWAY authentication.
OPENCLAWAPI_KEY=
OPENCLAW_BASE_URL=http://127.0.0.1:18789
OPENCLAW_AGENT=openclaw/croupier-director
OPENCLAW_CHAT_AGENT=openclaw/croupier-chat
# Lab test deadline; not a production animation timing guarantee.
OPENCLAW_TIMEOUT_MS=8000

# Optional native Control UI. Use the Director's bare HTTPS origin on the
# Gateway. Render Director infers its own origin with DASHBOARD_ENABLED=true.
# For local Compose ONLY: http://127.0.0.1:4189 plus ALLOW_LOOPBACK=true.
# Leave unset for normal local relay; do not proxy the public Render Gateway.
OPENCLAW_DASHBOARD_ORIGIN=
OPENCLAW_DASHBOARD_ALLOW_LOOPBACK=false

# Alternative: local lab -> public Director on Render -> private Gateway.
# Remote token is the Render Director's LAB_API_TOKEN, NOT OPENCLAWAPI_KEY.
LAB_REMOTE_URL=
LAB_REMOTE_TOKEN=
# With the optional local Compose stack: LAB_REMOTE_URL=http://127.0.0.1:4189
# and LAB_REMOTE_TOKEN must equal its LAB_API_TOKEN. Browser lab stays on 4188.

# Needed only when hosting the Director publicly (or in Docker Compose).
LAB_API_TOKEN=
HOST=127.0.0.1
PORT=4188

# Needed only for the supplied self-hosted Gateway/Compose deployment.
# A model provider credential is separate from the Gateway bearer above.
# These are an explicit example route; change them together for your provider.
# No inherited OPENAI_API_KEY is copied or used by the lab's configuration.
OPENCLAW_MODEL_API_KEY=
OPENCLAW_MODEL_BASE_URL=https://api.openai.com/v1
OPENCLAW_MODEL_ID=gpt-5.4-mini
OPENCLAW_MODEL_API=openai-responses
