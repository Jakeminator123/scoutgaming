# Official release, pinned rather than a moving latest tag.
FROM ghcr.io/openclaw/openclaw:2026.9.5@sha256:ea298b62be8955d3ef750e2004a610dd90c3a30e5f9886e5d654d78a0c573218
USER root
RUN mkdir -p /data/openclaw /opt/croupier-gateway && chown -R node:node /data/openclaw /opt/croupier-gateway
COPY --chown=node:node deploy/gateway-config.mjs deploy/start-gateway.mjs /opt/croupier-gateway/
ENV OPENCLAW_STATE_DIR=/data/openclaw \
    OPENCLAW_CONFIG_PATH=/data/openclaw/openclaw.json \
    OPENCLAW_CONFIG_READONLY=1 \
    OPENCLAW_GATEWAY_PORT=18789
USER node
EXPOSE 18789
# Retain the official image's tini entrypoint.
CMD ["node", "/opt/croupier-gateway/start-gateway.mjs"]
